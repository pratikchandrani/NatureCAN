# NatureCAN Environment Configuration Template
# Copy this file to .env and update with your values
# IMPORTANT: Never commit .env to version control!

# Database Credentials
# Use strong, unique passwords in production (min 32 chars, random)
MARIADB_DATABASE=naturecan
MARIADB_USER=naturecan
MARIADB_PASSWORD=CHANGE_THIS_TO_STRONG_32CHAR_PASS
MARIADB_ROOT_PASSWORD=CHANGE_THIS_ROOT_32CHAR_PASSWORD

# PHPMyAdmin Credentials (Development only - remove in production)
# PMA_USER=naturecan
# PMA_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# PHP Configuration
PHP_MEMORY_LIMIT=1024M
